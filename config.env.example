# Copy to config.env (git-ignored) and fill in. Read by the Makefile and scripts/.

# GCP project id: 6-30 chars, lowercase letters, digits and hyphens (no underscores).
# Must be globally unique - add a suffix if it's taken (e.g. gcp-streaming-dataflow-jk).
PROJECT_ID=gcp-streaming-dataflow

# `gcloud billing accounts list`
BILLING_ACCOUNT=XXXXXX-XXXXXX-XXXXXX

REGION=europe-west6
ZONE=europe-west6-a

# Monthly budget alert, in your billing account's currency.
BUDGET_AMOUNT=20

# Binance symbols (lowercase) and stream types to ingest.
SYMBOLS=btcusdt,ethusdt
STREAMS=trade

# Dataflow worker. n1-standard-2 is the safe default for Python + the Java
# Storage Write API harness. Try n1-standard-1 to roughly halve the hourly cost.
DATAFLOW_MACHINE_TYPE=n1-standard-2
